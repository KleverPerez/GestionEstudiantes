<?xml version="1.0" encoding="utf-8"?>

<configuration>

	<connectionStrings>
		<add name="ConexionSQL"
             connectionString="Data Source=localhost;Initial Catalog=GestionEstudiantes;User ID=app_gestion;Password=CAMBIAR_CONTRASENA_LOCAL;Encrypt=True;TrustServerCertificate=True;"
             providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode"
             value="None" />
	</appSettings>

	<system.web>

		<compilation debug="true" targetFramework="4.8" />

		<httpRuntime targetFramework="4.8" />

		<authentication mode="Forms">
			<forms
                loginUrl="~/Login.aspx"
                timeout="30"
                slidingExpiration="true"
                protection="All"
                cookieless="UseCookies" />
		</authentication>

		<authorization>
			<deny users="?" />
		</authorization>

	</system.web>

	<!-- Permitir acceso al inicio de sesión -->
	<location path="Login.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<!-- Permitir acceso al registro de cuentas -->
	<location path="RegistroUsuario.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

</configuration>
